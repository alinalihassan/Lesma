{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lesma",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#invalid"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.vardecl.lesma",
          "match": "\\b(let|var)\\b"
        },
        {
          "name": "keyword.control.lesma",
          "match": "\\b(if|else|while|for|in|break|continue|pass|return|defer|let|var|operator)\\b"
        },
        {
          "name": "keyword.module.lesma",
          "match": "\\b(from|import)\\b"
        },
        {
          "name": "keyword.other.lesma",
          "match": "\\b(export|class|enum|type|def|extern|trait|impl|private|overload)\\b"
        },
        {
          "name": "keyword.implicit.lesma",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.lesma",
          "match": "==|!="
        },
        {
          "name": "keyword.operator.range.lesma",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.lesma",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.lesma",
          "match": "="
        },
        {
          "name": "keyword.operator.expression.lesma",
          "match": "\\b(and|or|not|is|as)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.lesma",
          "match": "\\+|\\-|\\*|\\^|\\/|\\%"
        },
        {
          "name": "keyword.operator.relational.lesma",
          "match": ">=|<=|>|<"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#string-double-quoted"
        }
      ]
    },
    "string-double-quoted": {
      "name": "string.quoted.double.lesma",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-double-content"
        }
      ]
    },
    "string-double-content": {
      "patterns": [
        {
          "include": "#string-interpolation-expr"
        },
        {
          "name": "constant.character.escape.lesma",
          "match": "\\\\."
        },
        {
          "name": "string.quoted.double.lesma",
          "match": "[^\\\\\"$]+"
        },
        {
          "name": "string.quoted.double.lesma",
          "match": "\\$"
        }
      ]
    },
    "string-interpolation-expr": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.lesma"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.lesma"
        }
      },
      "contentName": "meta.embedded.line.lesma",
      "patterns": [
        {
          "include": "#string-double-quoted"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#functions"
        },
        {
          "include": "#invalid"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.other.lesma",
          "match": "[+-]?([0][obx])?[0-9]+"
        },
        {
          "name": "constant.numeric.float.lesma",
          "match": "[+-]?([0-9]*[.])?[0-9]+"
        },
        {
          "name": "constant.numeric.dec.lesma",
          "match": "[0-9]+"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "include": "#functionGenericTypeList"
        },
        {
          "include": "#genericTypeList"
        },
        {
          "comment": "Built-in Types",
          "name": "support.type.lesma",
          "match": "\\b(bool|cstr|int|float|void)\\b"
        },
        {
          "comment": "Type annotation",
          "name": "support.type.lesma",
          "match": "(?<=:\\s|->\\s)[a-zA-Z0-9_]+"
        }
      ]
    },
    "functionGenericTypeList": {
      "patterns": [
        {
          "name": "meta.type.parameters.lesma",
          "comment": "Generic parameters on def (e.g. def f<T: A & B>)",
          "begin": "(?<=\\bdef\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s)<",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.lesma"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.lesma"
            }
          },
          "patterns": [
            {
              "include": "#functionGenericTypeList"
            },
            {
              "name": "keyword.operator.intersection.lesma",
              "match": "&"
            },
            {
              "name": "keyword.operator.typing.lesma",
              "match": ":"
            },
            {
              "name": "punctuation.separator.type-parameters.lesma",
              "match": ","
            },
            {
              "name": "support.type.lesma",
              "match": "\\b(bool|cstr|int|float|void|[a-zA-Z_][a-zA-Z0-9_]*)\\b"
            }
          ]
        }
      ]
    },
    "genericTypeList": {
      "patterns": [
        {
          "name": "meta.type.parameters.lesma",
          "comment": "Generic parameter and argument lists",
          "begin": "(?<=[a-zA-Z0-9_])<(?=\\s*[a-zA-Z_][a-zA-Z0-9_]*(?:\\s*<[^\\n>]+>)?(?:\\s*,\\s*[a-zA-Z_][a-zA-Z0-9_]*(?:\\s*<[^\\n>]+>)?)*\\s*>\\s*(?:\\(|\\)|\\]|\\{|\\}|,|:|\\.|=|$|->|>|\\bimpl\\b))",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.lesma"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.lesma"
            }
          },
          "patterns": [
            {
              "include": "#genericTypeList"
            },
            {
              "name": "keyword.operator.intersection.lesma",
              "match": "&"
            },
            {
              "name": "punctuation.separator.type-parameters.lesma",
              "match": ","
            },
            {
              "name": "support.type.lesma",
              "match": "\\b(bool|cstr|int|float|void|[a-zA-Z_][a-zA-Z0-9_]*)\\b"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "include": "#implTraitList"
        },
        {
          "comment": "Catch the function call and function definition",
          "name": "support.function.lesma",
          "match": "(?=[a-zA-Z0-9_]+(?:<[^>\\n]+>)?\\()[a-zA-Z0-9_]+"
        },
        {
          "comment": "Class/Enum/Trait declaration",
          "name": "entity.name.type.lesma",
          "match": "(?<=class\\s|enum\\s|trait\\s)[a-zA-Z0-9_]+"
        }
      ]
    },
    "implTraitList": {
      "patterns": [
        {
          "comment": "First trait after impl (identifier + optional nested <...> via \\g<1> recursion)",
          "match": "(?<=\\bimpl\\s)([a-zA-Z_][a-zA-Z0-9_]*(?:<(?:[^<>]|\\g<1>)*>)?)",
          "captures": {
            "1": {
              "name": "entity.name.type.lesma"
            }
          }
        },
        {
          "comment": "Further traits after comma (same shape as first trait)",
          "match": ",\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:<(?:[^<>]|\\g<1>)*>)?)",
          "captures": {
            "1": {
              "name": "entity.name.type.lesma"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "comment": "Single line comment",
          "name": "comment.line.lesma",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lesma"
            }
          },
          "end": "(?=$)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "comment": "Boolean constants",
          "name": "constant.language.boolean.lesma",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "invalid": {
      "patterns": [
        {
          "comment": "Semicolons are invalid",
          "name": "invalid.illegal.lesma",
          "match": ";"
        }
      ]
    }
  },
  "scopeName": "source.lesma"
}