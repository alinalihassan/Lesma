// str: comparison, concat, search, trim, subscript (mutable copy via strdup).

if "a" + "b" != "ab" {
    exit(1)

}
if not "hello".startsWith("hel") {
    exit(2)
}
if "hello".startsWith("helloo") {
    exit(3)
}
if not "hello".endsWith("llo") {
    exit(4)
}
if "hi".endsWith("hello") {
    exit(5)

}
if not "banana".contains("nan") {
    exit(6)
}
if "abc".contains("zzz") {
    exit(7)

}
let foundBar = "foo bar".indexOf("bar")
if foundBar is null {
    exit(8)
} else {
    if foundBar != 4 {
        exit(8)
    }
}
if "solo".indexOf("zzz") is not null {
    exit(9)
}
if "  x  ".trim() != "x" {
    exit(10)
}
if "  yz".trimStart() != "yz" {
    exit(11)
}
if "ab  ".trimEnd() != "ab" {
    exit(12)

}
if "".isEmpty() != true {
    exit(13)
}
if "x".isEmpty() != false {
    exit(14)

}
if "ab"[0] != "a" {
    exit(15)
}
if "ab"[1] != "b" {
    exit(16)
}
// Mutable subscript: str owns a strdup buffer (safe for in-place byte writes).
var mut = "ab"
mut[0] = "c"
if mut != "cb" {
    exit(17)
}
if mut[1] != "b" {
    exit(18)

}
if "a" == "a" != true {
    exit(19)
}
if "a" != "b" != true {
    exit(20)

}
// split / join
var csv: list<str> = "a,b,c".split(",")
if csv.len() != 3 {
    exit(21)
}
if csv[0] != "a" {
    exit(22)
}
if csv[1] != "b" {
    exit(23)
}
if csv[2] != "c" {
    exit(24)
}
var empty_parts: list<str> = list<str>()
if ",".join(empty_parts) != "" {
    exit(25)
}
var three: list<str> = list<str>()
three.push("x")
three.push("y")
if "|".join(three) != "x|y" {
    exit(26)
}
var empty_csv: list<str> = "".split(",")
if empty_csv.len() != 1 {
    exit(27)
}
if empty_csv[0] != "" {
    exit(28)

}
// substring
if "abcdef".substring(2, 3) != "cde" {
    exit(29)
}
if "ab".substring(10, 1) != "" {
    exit(30)
}
if "ab".substring(0, 0) != "" {
    exit(31)
}
if "ab".substring(-5, 1) != "a" {
    exit(32)

}
// replace / repeat
if "a.a.a".replace(".", "_") != "a_a_a" {
    exit(33)
}
if "hi".replace("", "x") != "hi" {
    exit(34)
}
if "z".repeat(4) != "zzzz" {
    exit(35)
}
if "x".repeat(0) != "" {
    exit(36)

}
// ASCII case
if "AbC".toLower() != "abc" {
    exit(37)
}
if "aBc".toUpper() != "ABC" {
    exit(38)

}
// pad / charAt
if "7".padStart(4, "0") != "0007" {
    exit(39)
}
if "7".padEnd(4, "0") != "7000" {
    exit(40)
}
let charB = "ab".charAt(1)
if charB is null {
    exit(41)
} else {
    if charB != "b" {
        exit(41)
    }
}
