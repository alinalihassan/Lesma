# 1) Default method bodies on a trait (class can use them without overrides)
trait WithDefault
    def base() -> int
        return 7
    def extra() -> int
        return self.base() + 3

class C impl WithDefault
    def new()
        var _x = 0

# 2) Generic function with a trait bound: T must implement Twice
trait Twice
    def val() -> int

class A impl Twice
    var x: int
    def new(v: int)
        self.x = v
    def val() -> int
        return self.x * 2

def get_val<T: Twice>(o: T) -> int
    return o.val()

var c = C()
if c.extra() != 10
    exit(1)

var a = A(3)
if get_val(a) != 6
    exit(1)
