func sumAndMul(x: int, y: int) -> (int, int) {
  return (x + y, x * y)
}
let sumRes,
mulRes = sumAndMul(5, 10)
let combined = sumAndMul(5, 10)
print(combined[0])
print(combined[1])
print(sumRes)
print(mulRes)

