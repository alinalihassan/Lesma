{
  "name": "playground",
  "private": true,
  "type": "module",
  "workspaces": ["apps/server"],
  "scripts": {
    "dev": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/server build",
    "start": "bun run --cwd apps/server start",
    "typecheck": "bun run --cwd apps/server typecheck",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.2.0",
    "@cloudflare/workers-types": "^4.20250321.0",
    "wrangler": "^4.28.0"
  }
}
