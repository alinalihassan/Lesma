{
  "name": "lesma",
  "version": "0.18.1",
  "description": "Lesma language compiler and toolchain",
  "homepage": "https://lesma-lang.com/",
  "documentation": "https://lesma-lang.com/introduction/what-is-lesma/",
  "license": "MIT",
  "supports": "osx and linux",
  "maintainers": [
    "Alin Ali Hassan <hassanalinali@gmail.com>"
  ],
  "builtin-baseline": "3c4706f7aba0155cb34c366b5ef3397e75e0d14e",
  "dependencies": [
    {
      "name": "fmt",
      "version>=": "9.1.0"
    },
    {
      "name": "nameof",
      "version>=": "0.10.2"
    },
    {
      "name": "plf-nanotimer",
      "version>=": "1.0.8"
    }
  ],
  "features": {
    "cli": {
      "description": "Build CLI",
      "dependencies": [
        {
          "name": "cli11",
          "version>=": "2.3.1"
        }
      ]
    },
    "tests": {
      "description": "Build Tests",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.13.0"
        }
      ]
    },
    "benchmarks": {
      "description": "Build Benchmarks",
      "dependencies": [
        {
          "name": "benchmark",
          "version>=": "1.7.1"
        }
      ]
    },
    "build-llvm": {
      "description": "Build LLVM",
      "dependencies": [
        {
          "name": "llvm",
          "default-features": false,
          "features": [
            "default-targets",
            "clang",
            "enable-rtti",
            "enable-zlib",
            "enable-zstd",
            "lld",
            "tools"
          ]
        }
      ]
    },
    "dist": {
      "description": "Build Distributable"
    },
    "lsp": {
      "description": "Build LSP server (libgit2 for workspace file discovery respecting .gitignore)",
      "dependencies": [
        {
          "name": "libgit2",
          "default-features": false,
          "features": [
            "pcre2"
          ]
        }
      ]
    }
  }
}