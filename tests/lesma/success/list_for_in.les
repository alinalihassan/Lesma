let inferred = [1, 2, 3]
let typed: list<int> = [1, 2, 3]
let empty: list<int> = []

var sum: int = 0
for v in inferred
    sum = sum + v

for v in [4, 5]
    sum = sum + v

for v in empty
    exit(1)

if sum != 15
    exit(1)

if inferred is not list<int>
    exit(1)

if typed is not list<int>
    exit(1)
