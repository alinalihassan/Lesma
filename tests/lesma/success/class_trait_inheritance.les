# Class inheritance plus traits: `class Derived: Base impl Trait`, trait methods using inherited
# fields, generic bounds, `impl Trait<int>` on a subclass, and intersection impl on a subclass.
trait Scalable {
  func scale() -> int
}

class ScaleBase {
  var k: int

  func new(n: int) -> void {
    self.k = n
  }
}

class ScaleChild : ScaleBase impl Scalable {
  var bump: int

  func new(n: int, b: int) -> void {
    super.new(self, n)
    self.bump = b
  }
  func scale() -> int {
    return self.k * 2 + self.bump
  }
}

func scaled_sum<T: Scalable>(x: T) -> int {
  return x.scale()
}

trait HasU {
  func u_val() -> int
}

trait HasV {
  func v_val() -> int
}

class PairBase {
  var u: int
  var v: int

  func new(p: int, q: int) -> void {
    self.u = p
    self.v = q
  }
}

class PairCombo : PairBase impl HasU,
HasV {
  func new(p: int, q: int) -> void {
    super.new(self, p, q)
  }
  func u_val() -> int {
    return self.u
  }
  func v_val() -> int {
    return self.v
  }
}

func pair_total<T: HasU & HasV>(x: T) -> int {
  return x.u_val() + x.v_val()
}

trait Tagged<T> {
  func tag() -> T
}

class TagBase {
  var n: int

  func new(v: int) -> void {
    self.n = v
  }
}

class TagCell : TagBase impl Tagged<int> {
  func new(v: int) -> void {
    super.new(self, v)
  }
  func tag() -> int {
    return self.n + 100
  }
}
var sc = ScaleChild(5, 3)
if sc.k != 5 or sc.bump != 3 {
  exit(1)
}
if sc.scale() != 13 {
  exit(1)
}
if scaled_sum(sc) != 13 {
  exit(1)
}
var pc = PairCombo(10, 20)
if pc.u_val() != 10 or pc.v_val() != 20 {
  exit(1)
}
if pair_total(pc) != 30 {
  exit(1)
}
var tc = TagCell(7)
if tc.tag() != 107 {
  exit(1)
}
