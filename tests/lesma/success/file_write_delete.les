// file.write / file.delete — run from repo root (cwd).
let out_path: str = "tests/lesma/success/file_write_delete_out.txt"

file.write(out_path.cstr(), "roundtrip\n")

let r = file("tests/lesma/success/file_write_delete_out.txt")
let rText = r.text()
if rText is null {
  exit(1)
} else {
  if rText != "roundtrip\n" {
    exit(1)
  }
}
file.write(out_path.cstr(), r)

let r2 = file("tests/lesma/success/file_write_delete_out.txt")
let r2Text = r2.text()
if r2Text is null {
  exit(2)
} else {
  if r2Text != "roundtrip\n" {
    exit(2)
  }
}
let alt_path: str = "./tests/lesma/success/file_write_delete_out.txt"
file.write(alt_path.cstr(), r2)

let r3 = file("tests/lesma/success/file_write_delete_out.txt")
let r3Text = r3.text()
if r3Text is null {
  exit(3)
} else {
  if r3Text != "roundtrip\n" {
    exit(3)
  }
}
let h = file("tests/lesma/success/file_write_delete_out.txt")
h.delete()

if file("tests/lesma/success/file_write_delete_out.txt").text() is not null {
  exit(4)
}
