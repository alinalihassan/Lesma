func accepts(callback: func(int)) {
  callback(7)
}

func printer(value: int) {
  if value != 7 {
    exit(2)
  }
}

class CallbackHolder {
  var callback: func(int)

  func new(callback: func(int)) {
    self.callback = callback
  }
}
var holder = CallbackHolder(printer)

if holder.callback is not func(int) {
  exit(1)
}
accepts(holder.callback)
