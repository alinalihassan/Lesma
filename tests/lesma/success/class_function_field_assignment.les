func accepts(callback: func(int) -> void) -> void {
  var seen = 1
}

func printer(value: int) -> void {
  print(value)
}

class CallbackHolder {
  var callback: func(int) -> void

  func new(callback: func(int) -> void) -> void {
    self.callback = callback
  }
}
var holder = CallbackHolder(printer)

if holder.callback is not func(int) -> void {
  exit(1)
}
accepts(holder.callback)
