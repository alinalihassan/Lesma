# Multiline dict literal (newline inside braces must not end the statement early)
let d: dict<str, int> = {
    "a": 1,
    "b": 2
}

if d.len() != 2 {
    exit(1)

}
if d["a"] != 1 or d["b"] != 2 {
    exit(1)

}
# Integer keys across lines
let n = {
    1: 10,
    2: 20
}

if n.get(1) != 10 {
    exit(1)

}
print("ok")
