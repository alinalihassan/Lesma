# file.drop frees strdup'd path storage; run from repo root (cwd).
# Exercise several scopes so finalize runs repeatedly without crashing.

def useFixture() -> int
    let x = file("tests/lesma/success/file_api_fixture.txt")
    if x.text() != "lesma\n"
        return 1
    return 0

def run() -> int
    var i: int = 0
    while i < 20
        if useFixture() != 0
            return 2
        i += 1
    return 0

if run() != 0
    exit(1)
