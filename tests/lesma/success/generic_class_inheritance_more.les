# Extra generic inheritance coverage: multi-level chain, two type parameters, renamed type
# parameter on the subclass, and a partially applied generic base (Mix<int, V>).
class Root<T> {
  var a: T
  func new(v: T) -> void {
    self.a = v
  }
}

class Mid<T> : Root<T> {
  var b: T
  func new(v: T, w: T) -> void {
    super.new(self, v)
    self.b = w
  }
}

class Leaf<T> : Mid<T> {
  func new(v: T, w: T) -> void {
    super.new(self, v, w)
  }
}
var l = Leaf(1, 2)
if l.a != 1 or l.b != 2 {
  exit(1)
}
class PBase<T, U> {
  var a: T
  var b: U
  func new(x: T, y: U) -> void {
    self.a = x
    self.b = y
  }
}

class PChild<T, U> : PBase<T, U> {
  var c: T
  func new(x: T, y: U, z: T) -> void {
    super.new(self, x, y)
    self.c = z
  }
}
var p = PChild(1, 2.5, 3)
if p.a != 1 or p.b != 2.5 or p.c != 3 {
  exit(1)
}
class GBase<T> {
  var x: T
  func new(v: T) -> void {
    self.x = v
  }
}

class GChild<U> : GBase<U> {
  func new(v: U) -> void {
    super.new(self, v)
  }
}
var gc = GChild("hi")
if gc.x != "hi" {
  exit(1)
}
class Mix<T, U> {
  var t: T
  var u: U
  func new(a: T, b: U) -> void {
    self.t = a
    self.u = b
  }
}

class MixChild<V> : Mix<int, V> {
  func new(a: int, b: V) -> void {
    super.new(self, a, b)
  }
}
var m = MixChild(5, "x")
if m.t != 5 or m.u != "x" {
  exit(1)
}
