# Trait with two methods; generic bound dispatches both
trait PairOps
    def first() -> int
    def second() -> int

class P impl PairOps
    var a: int
    var b: int
    def new(x: int, y: int)
        self.a = x
        self.b = y
    def first() -> int
        return self.a
    def second() -> int
        return self.b

def total<T: PairOps>(p: T) -> int
    return p.first() + p.second()

var x = P(10, 32)
if total(x) != 42
    exit(1)
