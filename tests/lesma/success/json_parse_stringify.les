from json import Json, JsonErr, Serializable, JsonValue

export class User impl Serializable<User> {
  var name: str
  var age: int

  static func decode(value: any?) -> Result<User, JsonErr> {
    if value is not dict<str, any?> {
      let err: Result<User, JsonErr> = Result.Err(JsonErr("User expects object"))
      return err
    }

    let object = value as dict<str, any?>
    if object["name"] is not str or object["age"] is not int {
      return Result.Err(JsonErr("User missing required fields"))
    }

    let name: str = object["name"]
    let age: int = object["age"]

    return Result.Ok(User(name, age))
  }

  static func encode(value: User) -> Result<JsonValue, JsonErr> {
    var object: JsonValue = {"name": value.name, "age": value.age}
    return Result.Ok(object)
  }
}

let parsedResult = Json
  .parseObject(
    "{\"name\":\"Lesma\",\"active\":true,\"count\":3,\"ratio\":2.5,\"note\":null,\"items\":[1,false,null,\"line\\nnext\"],\"nested\":{\"ok\":true}}",
  )
let root = match parsedResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(1)
  }
}

if root["name"] is not str or root["name"] != "Lesma" {
  exit(2)
}
if root["active"] is not bool or root["active"] as bool != true {
  exit(3)
}
if root["count"] is not int or root["count"] as int != 3 {
  exit(4)
}
if root["ratio"] is not float {
  exit(5)
}
let ratio = root["ratio"] as float
if ratio < 2.49 or ratio > 2.51 {
  exit(6)
}
if root["note"] is not null {
  exit(7)
}
if root["items"] is not list<any?> {
  exit(8)
}
let items = root["items"] as list<any?>
if items[0] is not int or items[0] as int != 1 {
  exit(9)
}
if items[1] is not bool or items[1] as bool != false {
  exit(10)
}
if items[2] is not null {
  exit(11)
}
if items[3] is not str or items[3] as str != "line\nnext" {
  exit(12)
}

var built: dict<str, any?> = {}
built["quote"] = "\""
built["slash"] = "\\"
built["newline"] = "a\nb"
built["null"] = null
var array: list<any?> = []
array.push(7)
array.push(true)
array.push(null)
built["array"] = array

let stringifyResult = Json.stringify(built)
let encoded = match stringifyResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(15)
  }
}

if encoded.contains("\\\"") == false {
  exit(16)
}
if encoded.contains("\\\\") == false {
  exit(17)
}
if encoded.contains("\\n") == false {
  exit(18)
}
if encoded.contains("null") == false {
  exit(19)
}

let roundTripResult = Json.parseObject(encoded)
let roundTrip = match roundTripResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(20)
  }
}

if roundTrip["quote"] is not str or roundTrip["quote"] as str != "\"" {
  exit(21)
}
if roundTrip["newline"] is not str or roundTrip["newline"] as str != "a\nb" {
  exit(22)
}
if roundTrip["null"] is not null {
  exit(23)
}

let userRawResult = Json.parse("{\"name\":\"Ada\",\"age\":37}")
let userRaw = match userRawResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(24)
  }
}

let userResult = Json.decode<User>(userRaw)
let user = match userResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(25)
  }
}

if user.name != "Ada" or user.age != 37 {
  exit(26)
}

let encodedUserResult = Json.encode(user)
let encodedUser = match encodedUserResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(27)
  }
}

let encodedUserTextResult = Json.stringify(encodedUser)
let encodedUserText = match encodedUserTextResult {
  Result.Ok(value) => value
  Result.Err(_) => {
    exit(28)
  }
}

if encodedUserText.contains("\"Ada\"") == false {
  exit(29)
}
