# Long `else if` chain: only one branch runs; fall-through to final `else`.
var hits: int = 0
var x: int = 2
if x == 0 {
    hits = 1

}
else if x == 1 {
    hits = 2

}
else if x == 2 {
    hits = 3

}
else if x == 3 {
    hits = 4

}
else {
    hits = 99

}
if hits != 3 {
    exit(1)

}
x = 7
if x == 0 {
    hits = 10

}
else if x == 1 {
    hits = 20

}
else {
    hits = 30

}
if hits != 30 {
    exit(1)

}
