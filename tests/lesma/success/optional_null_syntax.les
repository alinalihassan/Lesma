class Box {
  var value: int

  func new(value: int) {
    self.value = value
  }

  func get() -> int {
    return self.value
  }
}

func unwrapInt(x: int?) -> int {
  if x is null {
    return 1
  } else {
    return x + 1
  }
}

func unwrapBox(x: Box?) -> int {
  if x is null {
    return 0
  } else {
    return x.get()
  }
}

var maybeInt: int? = null
if maybeInt is not null {
  exit(1)
}
if maybeInt != null {
  exit(1)
}
maybeInt = 4
if maybeInt is null {
  exit(1)
}
if maybeInt == null {
  exit(1)
}
if unwrapInt(maybeInt) != 5 {
  exit(1)
}

var maybeBox: Box? = null
if maybeBox is not null {
  exit(1)
}
if maybeBox != null {
  exit(1)
}
maybeBox = Box(9)
if maybeBox is null {
  exit(1)
} else if maybeBox == null {
  exit(1)
} else {
  if maybeBox.get() != 9 {
    exit(1)
  }
}

if unwrapBox(null) != 0 {
  exit(1)
}
if unwrapBox(Box(7)) != 7 {
  exit(1)
}
