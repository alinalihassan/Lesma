# Export a multi-level generic inheritance chain so import materialization can preserve it.
export class Root<T>
    var a: T
    def new(v: T)
        self.a = v

export class Mid<T>: Root<T>
    var b: T
    def new(v: T, w: T)
        super.new(self, v)
        self.b = w

export class Leaf<T>: Mid<T>
    def new(v: T, w: T)
        super.new(self, v, w)
