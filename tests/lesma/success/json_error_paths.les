from json import Json

let badParse = Json.parse("{\"name\": true,}")
if match badParse {
  Result.Err(err) => err.str().contains("byte")
  Result.Ok(_) => false
} == false {
  exit(1)
}

let badRoot = Json.parseObject("[1, 2, 3]")
if match badRoot {
  Result.Err(err) => err.str() == "JSON root is not an object"
  Result.Ok(_) => false
} == false {
  exit(2)
}

let badArray = Json.parseArray("{\"name\": true}")
if match badArray {
  Result.Err(err) => err.str() == "JSON root is not an array"
  Result.Ok(_) => false
} == false {
  exit(3)
}
