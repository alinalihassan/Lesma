# Existential parameter: coerce implementing class to fat pointer, dynamic dispatch
trait Drawable
    def area() -> float

class Circle impl Drawable
    var r: float
    def new(radius: float)
        self.r = radius
    def area() -> float
        return 3.14 * self.r * self.r

def render(d: Drawable) -> float
    return d.area()

var c = Circle(1.0)
if render(c) < 3.0
    exit(1)
