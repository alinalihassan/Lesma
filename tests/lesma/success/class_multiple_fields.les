# Test class with multiple fields and methods
class Point
    var x: int
    var y: int

    def new(x: int, y: int)
        self.x = x
        self.y = y

    def getX() -> int
        return self.x

    def getY() -> int
        return self.y

    def sum() -> int
        return self.getX() + self.getY()

var p = Point(40, 61)

if p.sum() != 101
    exit(1)

if p.getX() != 40
    exit(1)

if p.getY() != 61
    exit(1)
