// Test class with multiple fields and methods
class Point {
  var x: int
  var y: int

  func new(x: int, y: int) -> void {
    self.x = x
    self.y = y
  }
  func getX() -> int {
    return self.x
  }
  func getY() -> int {
    return self.y
  }
  func sum() -> int {
    return self.getX() + self.getY()
  }
}
var p = Point(40, 61)

if p.sum() != 101 {
  exit(1)
}
if p.getX() != 40 {
  exit(1)
}
if p.getY() != 61 {
  exit(1)
}
