var d: dict<str, int> = {"a": 1, "b": 2}

if d.len() != 2 {
  exit(1)
}
if not d.has("a") {
  exit(1)
}
let a0 = d.get("a")
if a0 is null {
  exit(1)
} else {
  if a0 != 1 {
    exit(1)
  }
}
if d["a"] != 1 {
  exit(1)
}
d.set("c", 3)

if d.len() != 3 {
  exit(1)
}
let c = d.get("c")
if c is null {
  exit(1)
} else {
  if c != 3 {
    exit(1)
  }
}
d.set("a", 9)

let a1 = d.get("a")
if a1 is null {
  exit(1)
} else {
  if a1 != 9 {
    exit(1)
  }
}
d["a"] = 8

if d["a"] != 8 {
  exit(1)
}
if d.len() != 3 {
  exit(1)
}
var n = {1: 10, 2: 20}

let one = n.get(1)
let two = n.get(2)
if one is null {
  exit(1)
} else {
  if one != 10 {
    exit(1)
  }
}
if two is null {
  exit(1)
} else {
  if two != 20 {
    exit(1)
  }
}
if n[1] != 10 or n[2] != 20 {
  exit(1)
}
n[3] = 30

if n[3] != 30 {
  exit(1)
}
let empty: dict<int, str> = {}

if empty.len() != 0 {
  exit(1)
}
print(d.keys.len())
