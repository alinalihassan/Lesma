# Intersection bound T: A & B — class must declare both traits
trait HasVal {
    func val() -> int

}
trait HasDbl {
    func dbl() -> int

}
class Both impl HasVal, HasDbl {
    var x: int
    func new(v: int) {
        self.x = v
    }
    func val() -> int {
        return self.x
    }
    func dbl() -> int {
        return self.x * 2

    }
}
func sum<T: HasVal & HasDbl>(o: T) -> int {
    return o.val() + o.dbl()

}
var b = Both(3)
if sum(b) != 9 {
    exit(1)
}
