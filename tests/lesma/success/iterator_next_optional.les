let r = range(1, 3).iter()
let first = r.next()
if first is null {
  exit(1)
} else {
  if first != 1 {
    exit(1)
  }
}
let second = r.next()
if second is null {
  exit(2)
} else {
  if second != 2 {
    exit(2)
  }
}
if r.next() is not null {
  exit(3)
}

var xs = list<int>()
xs.push(5)
let it = xs.iter()
let only = it.next()
if only is null {
  exit(5)
} else {
  if only != 5 {
    exit(4)
  }
}
if it.next() is not null {
  exit(5)
}

let bytes = "A".iter()
let byte = bytes.next()
if byte is null {
  exit(6)
} else {
  if byte != 65 as uint8 {
    exit(6)
  }
}
if bytes.next() is not null {
  exit(7)
}
