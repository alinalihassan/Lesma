enum Status {
  READY
  DONE
}

class Payload {
  var value: int

  func new(value: int) {
    self.value = value
  }
}

class Holder {
  var payload: Payload
  var status: Status

  func new(value: int) {
    self.payload = Payload(value)
    self.status = Status.READY
  }
  func isReady() -> bool {
    return self.status == Status.READY
  }
  func markDone() {
    self.status = Status.DONE
  }
}
var holder = Holder(101)

if not holder.isReady() {
  exit(1)
}
holder.markDone()
if holder.isReady() {
  exit(1)
}
