// Private `new` overload is only callable from the class body; public no-arg `new` seeds instances.
class Box {
  var v: int

  func new() -> void {
    self.v = 0
  }
  private func new(x: int) -> void {
    self.v = x
  }
  func bump() -> Box {
    return Box(self.v + 1)
  }
}
var b = Box()
var c = b.bump()
if c.v != 1 {
  exit(1)
}
