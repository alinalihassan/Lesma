// Generic class without explicit `func new`: synthesized ctor + inference.
class GBox<T> {
  var val: T

  func getVal() -> T {
    return self.val
  }
}
var ib = GBox(100)
if ib.getVal() != 100 {
  exit(1)
}
class GPair<T, U> {
  var a: T
  var b: U

  func getA() -> T {
    return self.a
  }
  func getB() -> U {
    return self.b
  }
}
var pr = GPair(7, 2.5)
if pr.getA() != 7 {
  exit(1)
}
if pr.getB() != 2.5 {
  exit(1)
}
