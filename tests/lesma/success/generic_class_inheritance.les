// Generic base class and generic subclass sharing type parameter T (super.new + inherited field).
class GBase<T> {
  var x: T

  func new(v: T) -> void {
    self.x = v
  }
}

class GChild<T> : GBase<T> {
  func new(v: T) -> void {
    super.new(self, v)
  }
}
var c = GChild(99)
if c.x != 99 {
  exit(1)
}
