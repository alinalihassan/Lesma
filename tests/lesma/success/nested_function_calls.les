# Test nested function calls
func add(a: int, b: int) -> int {
    return a + b

}
func multiply(a: int, b: int) -> int {
    return a * b

}
func subtract(a: int, b: int) -> int {
    return a - b

}
# Nested calls: subtract(multiply(add(2, 3), 20), -1) = subtract(100, -1) = 101
var result = subtract(multiply(add(2, 3), 20), -1)

if result != 101 {
    exit(1)

}
# Multiple levels of nesting
func double(x: int) -> int {
    return x * 2

}
func increment(x: int) -> int {
    return x + 1

}
# double(double(increment(increment(24)))) = double(double(26)) = double(52) = 104
if double(double(increment(increment(24)))) != 104 {
    exit(1)
}
