var xs = list<int>()
xs.push(1)
xs.push(2)
xs.push(3)

let mapper: func(int) -> int = func(x: int) => x * 3
let predicate: func(int) -> bool = func(x: int) => x > 1
let reducer: func(int, int) -> int = func(acc: int, x: int) => acc + x

var scaled = xs.map(mapper)
if scaled.len() != 3 or scaled[0] != 3 or scaled[1] != 6 or scaled[2] != 9 {
  exit(1)
}

var kept = xs.filter(predicate)
if kept.len() != 2 or kept[0] != 2 or kept[1] != 3 {
  exit(1)
}

let total = xs.reduce(reducer, 10)
if total != 16 {
  exit(1)
}

let chained_total = xs.map(mapper).reduce(reducer, 0)
if chained_total != 18 {
  exit(1)
}
