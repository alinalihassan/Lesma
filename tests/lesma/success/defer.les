// Deferred bodies run in LIFO order (last defer first), before the return expression is evaluated.
func lifo_order() -> int {
  var x = 0
  defer x = x * 10 + 2
  defer x = x * 10 + 1
  return x
}
if lifo_order() != 12 {
  exit(1)
}
func return_after_defer_assigns() -> int {
  var x = 0
  defer x = 100
  return x
}
if return_after_defer_assigns() != 100 {
  exit(1)
}
func early_branch(b: bool) -> int {
  var x = 0
  defer x = 7
  if b {
    return x
  }
  return x
}
if early_branch(true) != 7 {
  exit(1)
}
if early_branch(false) != 7 {
  exit(1)
}
class Counter {
  var n: int

  func new() -> void {
    self.n = 0
  }
  func run() -> int {
    defer self.n = self.n + 2
    defer self.n = self.n * 10
    return self.n
  }
}
var c = Counter()
if c.run() != 2 {
  exit(1)
}
func void_fallthrough() -> void {
  var x = 0
  defer x = 1
}

func void_via_return() -> void {
  var x = 0
  defer x = 2
  return
}
void_fallthrough()
void_via_return()

func no_op() -> int {
  return 0
}
defer no_op()
