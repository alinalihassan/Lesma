class Box {
  var value: int

  func new(value: int) {
    self.value = value
  }

  func get() -> int {
    return self.value
  }
}

class Holder {
  var current: Box? = null
}

func fail() -> int {
  exit(91)
  return 91
}

var maybe: int? = null
maybe ??= 7
if maybe is null {
  exit(1)
} else if maybe != 7 {
  exit(2)
}

maybe ??= fail()
if maybe ?? 0 != 7 {
  exit(2)
}

var holder = Holder()
holder.current ??= Box(11)
if holder.current is null {
  exit(3)
} else {
  if holder.current.get() != 11 {
    exit(3)
  }
}

holder.current ??= Box(12)
if holder.current is null {
  exit(4)
} else {
  if holder.current.get() != 11 {
    exit(4)
  }
}

var xs: list<int?> = [null, 4]
xs[0] ??= 9
xs[1] ??= fail()
if xs[0] ?? 0 != 9 {
  exit(5)
}
if xs[1] ?? 0 != 4 {
  exit(6)
}
