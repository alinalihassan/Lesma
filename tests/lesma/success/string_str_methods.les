// str: comparison, concat, search, trim, subscript (mutable copy via strdup).
if "a" + "b" != "ab" {
  exit(1)
}
if "Hello World".len() != 11 {
  exit(2)
}
if not "hello".startsWith("hel") {
  exit(3)
}
if "hello".startsWith("helloo") {
  exit(4)
}
if not "hello".endsWith("llo") {
  exit(5)
}
if "hi".endsWith("hello") {
  exit(6)
}
if not "banana".contains("nan") {
  exit(7)
}
if "abc".contains("zzz") {
  exit(8)
}
let foundBar = "foo bar".indexOf("bar")
if foundBar is null {
  exit(9)
} else {
  if foundBar != 4 {
    exit(10)
  }
}
if "solo".indexOf("zzz") is not null {
  exit(11)
}
if "  x  ".trim() != "x" {
  exit(12)
}
if "  yz".trimStart() != "yz" {
  exit(13)
}
if "ab  ".trimEnd() != "ab" {
  exit(14)
}
if "".isEmpty() != true {
  exit(15)
}
if "x".isEmpty() != false {
  exit(16)
}
if "ab"[0] != "a" {
  exit(17)
}
if "ab"[1] != "b" {
  exit(18)
}
// Mutable subscript: str owns a strdup buffer (safe for in-place byte writes).
var mut = "ab"
mut[0] = "c"
if mut != "cb" {
  exit(19)
}
if mut[1] != "b" {
  exit(20)
}
if "a" == "a" != true {
  exit(21)
}
if "a" != "b" != true {
  exit(22)
}
// split / join
var csv: list<str> = "a,b,c".split(",")
if csv.len() != 3 {
  exit(23)
}
if csv[0] != "a" {
  exit(24)
}
if csv[1] != "b" {
  exit(25)
}
if csv[2] != "c" {
  exit(26)
}
var empty_parts: list<str> = list<str>()
if ",".join(empty_parts) != "" {
  exit(27)
}
var three: list<str> = list<str>()
three.push("x")
three.push("y")
if "|".join(three) != "x|y" {
  exit(28)
}
var empty_csv: list<str> = "".split(",")
if empty_csv.len() != 1 {
  exit(29)
}
if empty_csv[0] != "" {
  exit(30)
}
// substring
if "abcdef".substring(2, 3) != "cde" {
  exit(31)
}
if "ab".substring(10, 1) != "" {
  exit(32)
}
if "ab".substring(0, 0) != "" {
  exit(33)
}
if "ab".substring(-5, 1) != "a" {
  exit(34)
}
// replace / repeat
if "a.a.a".replace(".", "_") != "a_a_a" {
  exit(35)
}
if "hi".replace("", "x") != "hi" {
  exit(36)
}
if "z".repeat(4) != "zzzz" {
  exit(37)
}
if "x".repeat(0) != "" {
  exit(38)
}
// ASCII case
if "AbC".toLower() != "abc" {
  exit(39)
}
if "aBc".toUpper() != "ABC" {
  exit(40)
}
// pad / charAt
if "7".padStart(4, "0") != "0007" {
  exit(41)
}
if "7".padEnd(4, "0") != "7000" {
  exit(42)
}
let charB = "ab".charAt(1)
if charB is null {
  exit(43)
} else {
  if charB != "b" {
    exit(44)
  }
}
if "ab".charAt(10) is not null {
  exit(45)
}
let safeA = "ab".get(0)
if safeA is null {
  exit(46)
} else {
  if safeA != "a" {
    exit(47)
  }
}
