trait Alpha {
  func a() -> int
}

trait Beta {
  func b() -> int
}

# Only Alpha — not valid for T: Alpha & Beta
class OnlyA impl Alpha {
  func new() -> void {
    var _ = 0
  }
  func a() -> int {
    return 1
  }
}

func both<T: Alpha & Beta>(x: T) -> int {
  return x.a() + x.b()
}
var o = OnlyA()
if both(o) != 1 {
  exit(1)
}
