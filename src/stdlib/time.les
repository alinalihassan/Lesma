func extern usleep(usec: int) -> void

/**
 * Suspends execution for a fractional number of seconds.
 *
 * @param seconds Delay in seconds.
 */
export func sleep(seconds: float) -> void {
  usleep((seconds * 1000000) as int)
}

/**
 * Suspends execution for a whole number of seconds.
 *
 * @param seconds Delay in seconds.
 */
export func sleep(seconds: int) -> void {
  usleep(seconds * 1000000)
}
