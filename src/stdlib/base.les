func extern remove(path: cstr) -> int

func extern rename(old_path: cstr, new_path: cstr) -> int

// ASCII whitespace only (TAB, LF, VT, FF, CR, SPACE). uint8 avoids signed-byte pitfalls with UTF-8.
func __str_byte_is_ascii_whitespace(b: uint8) -> bool {
  return b == 9 as uint8
    or b == 10 as uint8
    or b == 11 as uint8
    or b == 12 as uint8
    or b == 13 as uint8
    or b == 32 as uint8
}

/**
 * Iterates a sequence one value at a time.
 */
export trait Iterator<T> {
  func next() -> T?
}

/**
 * Produces a fresh iterator for a collection or sequence.
 */
export trait Iterable<T> {
  func iter() -> Iterator<T>
}

export trait Display {
  func str() -> str
}

export enum Result<T, E> {
  Ok(T)
  Err(E)

  func unwrap() -> T? {
    return match self {
      Ok(value) => value
      Err(_) => null
    }
  }
  func unwrapOr(defaultValue: T) -> T {
    return match self {
      Ok(value) => value
      Err(_) => defaultValue
    }
  }
}

// Integer sequence for `for i in range(...)`. Stop is exclusive. `range(n)` is `range(1, n)`.
// Step may be negative; step 0 yields no values (Python raises on zero step).
class range_iter impl Iterator<int> {
  var current: int
  var stop: int
  var step: int

  func new(start: int, stop: int, step: int) {
    self.current = start
    self.stop = stop
    self.step = step
  }
  func next() -> int? {
    if self.step > 0 {
      if self.current >= self.stop {
        return null
      }
    } else {
      if self.step < 0 {
        if self.current <= self.stop {
          return null
        }
      } else {
        return null
      }
    }
    let v = self.current
    self.current = self.current + self.step
    return v
  }
}

class range_values impl Iterable<int> {
  var start: int
  var stop: int
  var step: int

  func new(start: int, stop: int, step: int) {
    self.start = start
    self.stop = stop
    self.step = step
  }
  func iter() -> range_iter {
    return range_iter(self.start, self.stop, self.step)
  }
}

/**
 * Builds an integer range from 1 up to, but not including, stop.
 *
 * @param stop Exclusive upper bound.
 * @returns An iterable range of integers.
 */
export func range(stop: int) -> range_values {
  return range_values(1, stop, 1)
}

/**
 * Builds an integer range from start up to, but not including, stop.
 *
 * @param start Inclusive lower bound.
 * @param stop Exclusive upper bound.
 * @returns An iterable range of integers.
 */
export func range(start: int, stop: int) -> range_values {
  return range_values(start, stop, 1)
}

/**
 * Builds an integer range with an explicit step.
 *
 * @param start Inclusive lower bound.
 * @param stop Exclusive upper bound.
 * @param step Increment between values. Negative steps count down.
 * @returns An iterable range of integers.
 */
export func range(start: int, stop: int, step: int) -> range_values {
  return range_values(start, stop, step)
}

/**
 * Iterator implementation returned by list.iter().
 */
export class list_iter<T> impl Iterator<T> {
  var storage: __buffer<T>
  private var scan: int = 0

  func new(buf: __buffer<T>) {
    self.storage = buf
  }
  func next() -> T? {
    if self.scan >= __buffer_len(self.storage) {
      return null
    }
    var v = __buffer_get(self.storage, self.scan)
    self.scan += 1
    return v
  }
}

/**
 * Growable ordered collection backed by the stdlib buffer runtime.
 */
export class list<T> impl Iterable<T> {
  var storage: __buffer<T>

  func new() {
    self.storage = __buffer_new<T>()
  }
  func new(initial: __buffer<T>) {
    self.storage = initial
  }
  func iter() -> list_iter<T> {
    return list_iter<T>(self.storage)
  }
  func len() -> int {
    return __buffer_len(self.storage)
  }
  func push(value: T) {
    __buffer_push(self.storage, value)
  }
  func pop() -> T? {
    if self.len() == 0 {
      return null
    }
    return __buffer_pop(self.storage)
  }
  func get(index: int) -> T? {
    if index < 0 or index >= self.len() {
      return null
    }
    return __buffer_get(self.storage, index)
  }
  func clear() {
    __buffer_clear(self.storage)
  }
  func copy() -> list<T> {
    return list<T>(__buffer_copy(self.storage))
  }
  func operator [](index: int) -> T {
    return __buffer_get(self.storage, index)
  }
  func operator []=(index: int, value: T) {
    __buffer_set(self.storage, index, value)
  }
  func map<U>(f: func(T) -> U) -> list<U> {
    var out: list<U> = []
    var i: int = 0
    let n = self.len()
    while i < n {
      __buffer_push(out.storage, f(self[i]))
      i += 1
    }
    return out
  }
  func filter(pred: func(T) -> bool) -> list<T> {
    var out: list<T> = []
    var i: int = 0
    let n = self.len()
    while i < n {
      if pred(self[i]) {
        __buffer_push(out.storage, self[i])
      }
      i += 1
    }
    return out
  }
  func reduce<U>(f: func(U, T) -> U, init: U) -> U {
    var acc: U = init
    var i: int = 0
    let n = self.len()
    while i < n {
      acc = f(acc, self[i])
      i += 1
    }
    return acc
  }
}

// Parallel key/value buffers; lookup is linear. Field order keys then vals matches dict literal codegen.
/**
 * Associative container backed by parallel key and value buffers.
 */
export class dict<K, V> {
  var keys: __buffer<K>
  var vals: __buffer<V>

  func new() {
    self.keys = __buffer_new<K>()
    self.vals = __buffer_new<V>()
  }
  func len() -> int {
    return __buffer_len(self.keys)
  }
  func has(key: K) -> bool {
    var i: int = 0
    let n = self.len()
    while i < n {
      if __buffer_get(self.keys, i) == key {
        return true
      }
      i += 1
    }
    return false
  }
  func get(key: K) -> V? {
    var i: int = 0
    let n = self.len()
    while i < n {
      if __buffer_get(self.keys, i) == key {
        return __buffer_get(self.vals, i)
      }
      i += 1
    }
    return null
  }
  func set(key: K, value: V) {
    var i: int = 0
    let n = self.len()
    while i < n {
      if __buffer_get(self.keys, i) == key {
        __buffer_set(self.vals, i, value)
        return
      }
      i += 1
    }
    __buffer_push(self.keys, key)
    __buffer_push(self.vals, value)
  }
  func operator [](key: K) -> V {
    var i: int = 0
    let n = self.len()
    while i < n {
      if __buffer_get(self.keys, i) == key {
        return __buffer_get(self.vals, i)
      }
      i += 1
    }
    exit(1)
    return __buffer_get(self.vals, 0)
  }
  func operator []=(key: K, value: V) {
    self.set(key, value)
  }
}

/**
 * Iterates the raw UTF-8 bytes of a string.
 */
export class str_iter impl Iterator<uint8> {
  var storage: cstr
  private var scan: int = 0
  private var byte_len: int = 0

  func new(s: cstr) {
    self.storage = s
    self.byte_len = strlen(self.storage)
  }
  func next() -> uint8? {
    if self.scan >= self.byte_len {
      return null
    }
    var v = __cstr_byte_at(self.storage, self.scan)
    self.scan += 1
    return v
  }
}

/**
 * Owned UTF-8 string with common slicing, searching, and formatting helpers.
 */
export class str impl Iterable<uint8> {
  var storage: cstr

  // Own a writable NUL-terminated copy; never retain arbitrary cstr (literals, borrowed buffers).
  func new(s: cstr) {
    self.storage = strdup(s)
  }
  func cstr() -> cstr {
    return self.storage
  }
  func len() -> int {
    return strlen(self.storage)
  }
  func isEmpty() -> bool {
    return self.len() == 0
  }
  func operator [](index: int) -> str {
    return str(__str_slice(self.storage, index, 1))
  }
  func operator []=(index: int, value: str) {
    if value.len() == 0 {
      return
    }
    __cstr_byte_set(self.storage, index, __cstr_byte_at(value.storage, 0))
  }
  func operator +(rhs: str) -> str {
    return str(__str_concat(self.storage, rhs.storage))
  }
  func startsWith(prefix: str) -> bool {
    let n = self.len()
    let m = prefix.len()
    if m > n {
      return false
    }
    return strncmp(self.storage, prefix.storage, m) == 0
  }
  func endsWith(suffix: str) -> bool {
    let n = self.len()
    let m = suffix.len()
    if m > n {
      return false
    }
    return strcmp(__cstr_offset(self.storage, n - m), suffix.storage) == 0
  }
  func contains(sub: str) -> bool {
    return self.indexOf(sub) is not null
  }
  func indexOf(needle: str) -> int? {
    let idx = __cstr_index_of(self.storage, needle.storage)
    if idx < 0 {
      return null
    }
    return idx
  }
  func trimStart() -> str {
    var i: int = 0
    let n: int = self.len()
    while i < n {
      if not __str_byte_is_ascii_whitespace(__cstr_byte_at(self.storage, i)) {
        break
      }
      i += 1
    }
    return str(__str_slice(self.storage, i, n - i))
  }
  func trimEnd() -> str {
    let n: int = self.len()
    if n == 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var j: int = n - 1
    while j >= 0 {
      if not __str_byte_is_ascii_whitespace(__cstr_byte_at(self.storage, j)) {
        break
      }
      j -= 1
    }
    return str(__str_slice(self.storage, 0, j + 1))
  }
  func trim() -> str {
    return self.trimStart().trimEnd()
  }
  // One code unit at index (same as self[index]; slice form matches operator []).
  func charAt(index: int) -> str? {
    if index < 0 or index >= self.len() {
      return null
    }
    return str(__str_slice(self.storage, index, 1))
  }
  func get(index: int) -> str? {
    return self.charAt(index)
  }
  // start is clamped (negative -> 0); len <= 0 yields "". If start >= len(), yields "".
  func substring(start: int, len: int) -> str {
    let n: int = self.len()
    var s: int = start
    if s < 0 {
      s = 0
    }
    if s >= n {
      return str(__str_slice(self.storage, 0, 0))
    }
    if len <= 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var take: int = len
    if s + take > n {
      take = n - s
    }
    return str(__str_slice(self.storage, s, take))
  }
  // Empty separator: one str per code unit. Otherwise splits on each non-overlapping occurrence.
  func split(sep: str) -> list<str> {
    var parts: list<str> = list<str>()
    let n: int = self.len()
    let m: int = sep.len()
    if m == 0 {
      var k: int = 0
      while k < n {
        parts.push(str(__str_slice(self.storage, k, 1)))
        k += 1
      }
      return parts
    }
    var start: int = 0
    while start <= n {
      let rel: int = __cstr_index_of(__cstr_offset(self.storage, start), sep.storage)
      if rel < 0 {
        parts.push(str(__str_slice(self.storage, start, n - start)))
        break
      }
      let hit: int = start + rel
      parts.push(str(__str_slice(self.storage, start, hit - start)))
      start = hit + m
    }
    return parts
  }
  // Separator is self (e.g. ",".join(parts)). Empty list -> "".
  func join(parts: list<str>) -> str {
    let pl: int = parts.len()
    if pl == 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var out: str = parts[0]
    var j: int = 1
    while j < pl {
      out = out + self + parts[j]
      j += 1
    }
    return out
  }
  // n <= 0 -> "". Concatenates n copies of self.
  func repeat(n: int) -> str {
    if n <= 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var out: str = str(__str_slice(self.storage, 0, 0))
    var i: int = 0
    while i < n {
      out = out + self
      i += 1
    }
    return out
  }
  // Empty needle: unchanged self. Otherwise replaces every non-overlapping occurrence.
  func replace(needle: str, replacement: str) -> str {
    let m: int = needle.len()
    if m == 0 {
      return self
    }
    var out: str = str(__str_slice(self.storage, 0, 0))
    var start: int = 0
    let n: int = self.len()
    while start <= n {
      let rel: int = __cstr_index_of(__cstr_offset(self.storage, start), needle.storage)
      if rel < 0 {
        out = out + str(__str_slice(self.storage, start, n - start))
        break
      }
      let hit: int = start + rel
      out = out + str(__str_slice(self.storage, start, hit - start)) + replacement
      start = hit + m
    }
    return out
  }
  // ASCII A–Z / a–z only; other bytes unchanged (not full Unicode case mapping).
  func toLower() -> str {
    let n: int = self.len()
    if n == 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var buf: cstr = calloc(n + 1, 1) as cstr
    var i: int = 0
    while i < n {
      var b: uint8 = __cstr_byte_at(self.storage, i)
      if b >= 65 as uint8 and b <= 90 as uint8 {
        b = b + 32 as uint8
      }
      __cstr_byte_set(buf, i, b)
      i += 1
    }
    let out: str = str(buf)
    free(buf)
    return out
  }
  func toUpper() -> str {
    let n: int = self.len()
    if n == 0 {
      return str(__str_slice(self.storage, 0, 0))
    }
    var buf: cstr = calloc(n + 1, 1) as cstr
    var i: int = 0
    while i < n {
      var b: uint8 = __cstr_byte_at(self.storage, i)
      if b >= 97 as uint8 and b <= 122 as uint8 {
        b = b - 32 as uint8
      }
      __cstr_byte_set(buf, i, b)
      i += 1
    }
    let out: str = str(buf)
    free(buf)
    return out
  }
  // pad must be non-empty; uses its first code unit repeated. width is target byte length.
  func padStart(width: int, pad: str) -> str {
    if pad.len() == 0 {
      return self
    }
    let n: int = self.len()
    if width <= n {
      return self
    }
    let unit: str = str(__str_slice(pad.storage, 0, 1))
    let need: int = width - n
    return unit.repeat(need) + self
  }
  func padEnd(width: int, pad: str) -> str {
    if pad.len() == 0 {
      return self
    }
    let n: int = self.len()
    if width <= n {
      return self
    }
    let unit: str = str(__str_slice(pad.storage, 0, 1))
    let need: int = width - n
    return self + unit.repeat(need)
  }
  func operator ==(rhs: str) -> bool {
    return strcmp(self.storage, rhs.storage) == 0
  }
  func operator !=(rhs: str) -> bool {
    return strcmp(self.storage, rhs.storage) != 0
  }
  func toInt() -> int {
    return atoll(self.storage)
  }
  func toFloat() -> float {
    return strtod(self.storage)
  }
  func iter() -> str_iter {
    return str_iter(self.storage)
  }
}

// Read path as UTF-8 bytes (no BOM handling). text() returns null on open/read errors.
/**
 * File handle wrapper for reading, writing, and deleting files.
 */
export class file {
  var storage: cstr

  func new(path: cstr) {
    self.storage = strdup(path)
  }
  func text() -> str? {
    var fp: *int8 = fopen(self.storage, "rb")
    if fp == 0 {
      return null
    }
    if fseek(fp, 0, 2) != 0 {
      fclose(fp)
      return null
    }
    var n: int = ftell(fp)
    if n < 0 {
      fclose(fp)
      return null
    }
    if fseek(fp, 0, 0) != 0 {
      fclose(fp)
      return null
    }
    var buf: cstr = calloc(n + 1, 1) as cstr
    var got: int = fread(buf, 1, n, fp)
    fclose(fp)
    if got != n {
      free(buf)
      return null
    }
    let result: str = str(buf)
    free(buf)
    return result
  }
  static func write(path: cstr, data: str) {
    var fp: *int8 = fopen(path, "wb")
    if fp == 0 {
      return
    }
    let n: int = data.len()
    if n > 0 {
      fwrite(data.cstr(), 1, n, fp)
    }
    fclose(fp)
  }
  static func write(path: cstr, src: file) {
    if strcmp(path, src.storage) == 0 {
      return
    }
    var in_fp: *int8 = fopen(src.storage, "rb")
    if in_fp == 0 {
      return
    }
    let temp_path: str = str(path) + ".tmp.${time(0)}.${rand()}"
    remove(temp_path.cstr())
    var out_fp: *int8 = fopen(temp_path.cstr(), "wb")
    if out_fp == 0 {
      fclose(in_fp)
      return
    }
    var buf: cstr = calloc(4096, 1) as cstr
    while true {
      let got: int = fread(buf, 1, 4096, in_fp)
      if got <= 0 {
        break
      }
      fwrite(buf, 1, got, out_fp)
      if got < 4096 {
        break
      }
    }
    free(buf)
    fclose(in_fp)
    fclose(out_fp)
    if rename(temp_path.cstr(), path) != 0 {
      remove(temp_path.cstr())
    }
  }
  func delete() {
    remove(self.storage)
  }
}

/**
 * Terminates the current program with the given exit code.
 *
 * @param code Process exit status.
 */
export func extern exit(code: int)

/**
 * Reads a line from standard input with no prompt.
 *
 * @returns The entered text without the trailing newline.
 */
export func input() -> str {
  return input("")
}

/**
 * Reads a line from standard input after printing a prompt.
 *
 * @param prompt Prompt text written before reading.
 * @returns The entered text without the trailing newline.
 */
export func input(prompt: str) -> str {
  if strlen(prompt.cstr()) > 0 {
    printf("%s", prompt.cstr())
  }
  var line: cstr = calloc(4096, 1) as cstr
  var ignored: cstr = calloc(2, 1) as cstr
  let read: int = scanf("%4095[^\n]", line)

  if read == 0 {
    scanf("%1c", ignored)
  }
  if read > 0 {
    scanf("%1c", ignored)
  }
  let result: str = str(line)
  free(line)
  free(ignored)
  return result
}

// Inclusive integer in either order (min/max need not match argument order).
/**
 * Returns a pseudorandom integer between the two bounds, inclusive.
 *
 * @param bound1 One end of the range.
 * @param bound2 The other end of the range.
 * @returns A value in the inclusive range [min(bound1, bound2), max(bound1, bound2)].
 */
export func random(bound1: int, bound2: int) -> int {
  srand(time(0))

  if bound1 == bound2 {
    return bound1
  }
  if bound1 < bound2 {
    return bound1 + rand() % (bound2 - bound1 + 1)
  }
  return bound2 + rand() % (bound1 - bound2 + 1)
}

/**
 * Prints a string followed by a newline.
 *
 * @param text String value to print.
 */
export func print(text: str) {
  printf("%s\n", text.cstr())
}

export func print(value: Display) {
  printf("%s\n", value.str().cstr())
}

/**
 * Prints an integer followed by a newline.
 *
 * @param num Integer value to print.
 */
export func print(num: int) {
  printf("%lld\n", num)
}

/**
 * Prints an int8 as a character followed by a newline.
 *
 * @param char Character byte to print.
 */
export func print(char: int8) {
  printf("%c\n", char)
}

/**
 * Prints a uint8 as a character followed by a newline.
 *
 * @param char Character byte to print.
 */
export func print(char: uint8) {
  printf("%c\n", char)
}

/**
 * Prints a floating-point number followed by a newline.
 *
 * @param num Floating-point value to print.
 */
export func print(num: float) {
  printf("%g\n", num)
}

/**
 * Prints the boolean value as "true" or "false".
 *
 * @param value The boolean value to print.
 */
export func print(value: bool) {
  if value {
    print("true")
  } else {
    print("false")
  }
}
