func extern printf(fmt: cstr, ...)

func extern scanf(fmt: cstr, ...) -> int

export func extern calloc(count: int, size: int) -> *int8

func extern malloc(size: int) -> *int8

func extern free(ptr: cstr)

func extern strlen(s: cstr) -> int

func extern atoll(s: cstr) -> int

func extern strtod(s: cstr) -> float

func extern rand() -> int

func extern srand(seed: int)

// C `time(NULL)`; pass 0.
func extern time(timer: int) -> int

func extern strcmp(a: cstr, b: cstr) -> int

func extern strncmp(a: cstr, b: cstr, n: int) -> int

func extern strdup(s: cstr) -> cstr

func extern fopen(path: cstr, mode: cstr) -> *int8

func extern fclose(stream: *int8) -> int

func extern fread(dest: cstr, size: int, count: int, stream: *int8) -> int

