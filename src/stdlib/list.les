export class list<T>
    var storage: __buffer<T>
    var __iter_index: int = 0

    def new()
        self.storage = __buffer_new<T>()

    def len() -> int
        return __buffer_len(self.storage)

    def push(value: T)
        __buffer_push(self.storage, value)

    def pop() -> T
        return __buffer_pop(self.storage)

    def clear()
        __buffer_clear(self.storage)

    def copy() -> list<T>
        var result: list<T> = list<T>()
        result.storage = __buffer_copy(self.storage)
        return result

    def iter() -> *list<T>
        self.__iter_index = 0
        return self

    def has_next() -> bool
        return self.__iter_index < __buffer_len(self.storage)

    def next() -> T
        var value = __buffer_get(self.storage, self.__iter_index)
        self.__iter_index += 1
        return value

    def operator [](index: int) -> T
        return __buffer_get(self.storage, index)

    def operator []=(index: int, value: T)
        __buffer_set(self.storage, index, value)
