{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Configures the project for debugging",
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LESMA_BUILD_CLI": "ON",
        "LESMA_BUILD_LSP": "ON",
        "LESMA_BUILD_TESTS": "ON",
        "LESMA_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "Release",
      "displayName": "Release",
      "description": "Configures the project for release",
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LESMA_BUILD_CLI": "ON",
        "LESMA_BUILD_TESTS": "ON",
        "LESMA_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "Release_Dist",
      "displayName": "Release and Distribute",
      "description": "Configures the project for release and create distributable. This is meant for CI/CD",
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "debug": {
        "output": true
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LESMA_BUILD_CLI": "ON",
        "LESMA_BUILD_TESTS": "ON",
        "LESMA_BUILD_BENCHMARKS": "ON",
        "LESMA_BUILD_DIST": "ON"
      }
    },
    {
      "name": "Release_Dist_CI",
      "displayName": "Release Dist for CI (no benchmarks)",
      "description": "Same as Release_Dist but benchmarks off to avoid vcpkg benchmark port build issues in CI",
      "inherits": "Release_Dist",
      "cacheVariables": {
        "LESMA_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "Debug_Asan",
      "displayName": "Debug with AddressSanitizer",
      "description": "Debug build with AddressSanitizer and LeakSanitizer for memory and leak detection. Use on macOS (including Apple Silicon) and Linux instead of Valgrind.",
      "inherits": "Debug",
      "binaryDir": "${sourceDir}/build/Debug_Asan",
      "cacheVariables": {
        "LESMA_SANITIZE_ADDRESS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Release_Dist",
      "configurePreset": "Release_Dist"
    },
    {
      "name": "Release_Dist_CI",
      "configurePreset": "Release_Dist_CI"
    },
    {
      "name": "Debug_Asan",
      "configurePreset": "Debug_Asan"
    }
  ],
  "testPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Debug_Asan",
      "configurePreset": "Debug_Asan"
    }
  ],
  "workflowPresets": [
    {
      "name": "Debug Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "Debug"
        },
        {
          "type": "build",
          "name": "Debug"
        },
        {
          "type": "test",
          "name": "Debug"
        }
      ]
    },
    {
      "name": "Release Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "Release"
        },
        {
          "type": "build",
          "name": "Release"
        },
        {
          "type": "test",
          "name": "Release"
        }
      ]
    }
  ]
}